---
import { useStoryblokApi } from "@storyblok/astro";
import StoryblokComponent from "@storyblok/astro/StoryblokComponent.astro";

import Layout from "@layouts/Layout.astro";

import { Image } from "astro:assets";

import people from "@images/jobs/1-people.jpeg";

const storyblokApi = useStoryblokApi();
const { data } = await storyblokApi.get("cdn/stories/stellenangebote", {
  version: "draft",
});
const story = data.story;
---

<Layout title="Stellenangebote - Assiston e.V." noContactSection>
  <StoryblokComponent blok={story.content.body[0]} />

  <main id="main">
    <div class="container">
      <Image alt="" height={532} src={people} />

      <div class="text">
        <StoryblokComponent blok={story.content.body[1]} />
      </div>
    </div>
  </main>
</Layout>

<style>
  img {
    border-radius: 8px;
    object-fit: cover;
    width: 100%;
  }

  .highlight {
    font-size: var(--step-2);
  }

  h2 {
    margin-top: var(--space-l);
  }

  .container p:last-child {
    font-family: "Lexend Medium", Geneva, Tahoma, sans-serif;
  }

  a {
    color: var(--color-terra-cotta-500);
  }

  .text {
    margin-top: var(--space-l);
  }
</style>
