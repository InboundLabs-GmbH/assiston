---
import Layout from "@layouts/Layout.astro";
// import HeroSection from "@components/hero-section.astro";

import { Image } from "astro:assets";
import heroImage from "@images/hero-image-services.png";

import carousel from "@images/services/1-carousel.jpeg";

import serviceOne from "@images/services/2-services.svg";
import serviceTwo from "@images/services/3-services.svg";
import serviceThree from "@images/services/4-services.svg";
import serviceFour from "@images/services/5-services.svg";
import diagram from "@images/services/6-diagram.svg";

import listItemOne from "@images/services/7-list-item.svg";
import listItemTwo from "@images/services/8-list-item.svg";
import listItemThree from "@images/services/9-list-item.svg";
import listItemFour from "@images/services/10-list-item.svg";
import listItemFive from "@images/services/11-list-item.svg";

const services = [
  {
    src: serviceOne,
    title: "1. Erstgespräch",
    description:
      "Dabei besprechen wir Ihre Wünsche und helfen Ihnen bei der Antragstellung, falls Sie noch keinen gestellt haben.",
  },
  {
    src: serviceTwo,
    title: "2. Team finden",
    description:
      "Nachdem Ihr Antrag genehmigt wurde, kümmern wir uns in Absprache mit Ihnen um die Zusammenstellung eines Assistenzteams.",
  },
  {
    src: serviceThree,
    title: "3. Team­koordination und Team­sitzungen",
    description:
      "Wir helfen bei der Organisation und Koordination der Teams und legen Wert auf regelmäßige Teamsitzungen.",
  },
  {
    src: serviceFour,
    title: "4. Personal­verwaltung und Ab­rechnung",
    description:
      "Wir übernehmen komplett alle administrativen Aufgaben für Sie.",
  },
];

const listItems = [
  { src: listItemOne, title: "Eigener Dienstplan" },
  { src: listItemTwo, title: "Individuelle Dienstzeiten" },
  { src: listItemThree, title: "Festes Team" },
  { src: listItemFour, title: "Verwaltungsaufgaben" },
  { src: listItemFive, title: "Hilfe bei Antragstellung" },
];
---

<Layout title="Leistungen - Assiston e.V.">
  <!-- <HeroSection
    heading="Unsere Leistungen"
    kicker="Kurze Beschreibung hinzufügen?"
    src={heroImage}
  /> -->

  <main id="main">
    <section aria-label="Ablauf">
      <div class="container">
        <div class="intro">
          <div class="intro-text">
            <h2>Sie haben sich für eine persönliche Assistenz entschieden.</h2>
            <p>
              Jetzt helfen wir Ihnen dabei ein rundum-sorglos-Paket zur
              Verfügung zu stellen, so dass Sie sich auf ein selbstbestimmtes
              Leben konzentrieren können.
            </p>
          </div>
          <Image alt="" src={carousel} width={560} />
        </div>

        <dl>
          {
            services.map(({ src, title, description }) => (
              <div class="process-container">
                <Image alt="" src={src} width={300} />
                <div class="details-text">
                  <dt class="highlight">{title}</dt>
                  <dd>{description}</dd>
                </div>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section aria-label="Details">
      <div class="container">
        <h2>Unser Service für Sie!</h2>

        <div>
          <ul role="list">
            {
              listItems.map(({ src, title }) => (
                <li>
                  <Image alt="" src={src} />
                  {title}
                </li>
              ))
            }
          </ul>

          <Image alt="" src={diagram} />
        </div>
      </div>
    </section>

    <section aria-label="Umsetzung">
      <div class="container">
        <h2>Umsetzung</h2>

        <div class="action-container">
          <p class="highlight">
            Jeder Kunde hat andere Anforderungen, auf die wir eingehen!
          </p>
          <div>
            <p>
              Wir freuen uns, individuell auf jeden Kunden mit den
              unterschiedlichsten Bedürfnissen eingehen zu dürfen.
            </p>
            <p>
              So weit es geht, versuchen wir, Dienstpläne, Kommunikation und
              andere Themen so zu gestalten, dass ein optimales Arbeitsumfeld
              für Sie entsteht.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* General */

  .container,
  dl {
    margin: 0 auto;
    max-width: var(--max-width);
  }

  dd {
    margin: var(--space-xs) 0 0 0;
  }

  /* Section 1 */

  section[aria-label="Ablauf"] {
    background: var(--color-light-cream-50);
  }

  .intro {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-l);
    justify-content: space-evenly;
  }

  .intro img {
    border-radius: 8px;
    height: auto;
  }

  .intro-text {
    max-width: 90ch;
  }

  .intro-text h2 {
    font-size: var(--step-3);
  }

  /* Process section */

  dl {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
    margin-top: var(--space-2xl);
  }

  .details-text {
    background: var(--color-neutral-50);
    display: flex;
    flex-direction: column;
    padding: var(--space-l);
    max-width: 50ch;
  }

  .process-container {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    justify-content: center;
  }

  .process-container:nth-child(even) {
    flex-direction: row-reverse;
  }

  /* Section 2 */

  section[aria-label="Details"] h2 {
    margin-bottom: var(--space-l);
  }

  section[aria-label="Details"] ul {
    display: flex;
    flex-direction: column;
    flex-wrap: wrap;
    font-size: var(--step-2);
    gap: var(--space-l);
  }

  section[aria-label="Details"] ul li {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  section[aria-label="Details"] ul li:nth-child(2) {
    color: var(--color-cal-poly-green-500);
  }

  section[aria-label="Details"] ul li:nth-child(3) {
    color: var(--color-deep-burgundy-500);
  }

  section[aria-label="Details"] ul li:nth-child(4) {
    color: var(--color-terra-cotta-500);
  }

  section[aria-label="Details"] ul li:last-child {
    color: var(--color-terra-cotta-800);
  }

  section[aria-label="Details"] div {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    justify-content: center;
  }

  /* Section 3 */

  section[aria-label="Umsetzung"] {
    background: var(--color-light-cream-50);
  }

  section[aria-label="Umsetzung"] .container {
    width: fit-content;
  }

  .action-container {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
    margin-top: var(--space-l);
  }

  .action-container .highlight {
    max-width: 20ch;
  }

  .action-container p {
    margin: 0;
  }

  .action-container div p {
    max-width: 45ch;
  }

  .action-container div p:last-child {
    margin-top: var(--space-m);
  }
</style>
