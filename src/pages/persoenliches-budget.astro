---
import { useStoryblokApi } from "@storyblok/astro";
import StoryblokComponent from "@storyblok/astro/StoryblokComponent.astro";

import Layout from "@layouts/Layout.astro";

const storyblokApi = useStoryblokApi();
const { data } = await storyblokApi.get("cdn/stories/persoenliches-budget", {
  version: "draft",
});
const story = data.story;
---

<Layout title="Persönliches Budget - Assiston e.V.">
  <StoryblokComponent blok={story.content.body[0]} />

  <main id="main">
    <section aria-label="Allgemein">
      <div class="container">
        <div class="smol-css-grid">
          <StoryblokComponent blok={story.content.body[1]} />
        </div>

        <StoryblokComponent blok={story.content.body[2]} />

        <dl class="gallery">
          <StoryblokComponent blok={story.content.body[3]} />
          <StoryblokComponent blok={story.content.body[4]} />
          <StoryblokComponent blok={story.content.body[5]} />
        </dl>
      </div>
    </section>

    <section aria-label="Prozess">
      <div class="container">
        <StoryblokComponent blok={story.content.body[6]} />
        <StoryblokComponent blok={story.content.body[7]} />

        <dl>
          <StoryblokComponent blok={story.content.body[8]} />
          <StoryblokComponent blok={story.content.body[9]} />
          <StoryblokComponent blok={story.content.body[10]} />
          <StoryblokComponent blok={story.content.body[11]} />
          <StoryblokComponent blok={story.content.body[12]} />
        </dl>

        <StoryblokComponent blok={story.content.body[13]} />
      </div>
    </section>

    <section aria-label="Leistungen">
      <div class="container">
        <StoryblokComponent blok={story.content.body[14]} />
        <ul role="list">
          <StoryblokComponent blok={story.content.body[15]} />
          <StoryblokComponent blok={story.content.body[16]} />
          <StoryblokComponent blok={story.content.body[17]} />
          <StoryblokComponent blok={story.content.body[18]} />
          <StoryblokComponent blok={story.content.body[19]} />
          <StoryblokComponent blok={story.content.body[20]} />
        </ul>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* General */

  dd {
    margin: 0;
    max-width: 30ch;
  }

  .smol-css-grid {
    display: grid;
    grid-gap: var(--space-m);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 40ch), 1fr));

    p {
      margin: 0;
    }
  }

  /* Section 1 */

  section[aria-label="Allgemein"] {
    background: var(--color-light-cream-50);
  }

  section[aria-label="Allgemein"] {
    h2 {
      margin-top: var(--space-2xl);
    }
  }

  .highlight {
    margin: 0;
    max-width: 30ch;
  }

  .gallery {
    display: grid;
    grid-gap: var(--space-m);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20ch), 1fr));
    justify-items: center;
    width: 100%;
  }

  .gallery dt {
    text-align: center;
  }

  .gallery div {
    display: flex;
    flex-direction: column;
    flex-wrap: wrap;
    gap: var(--space-m);
  }

  /* Section 2 */

  section[aria-label="Prozess"] h2 {
    margin: 0;
  }

  section[aria-label="Prozess"] {
    h3 {
      margin: var(--space-2xl) 0 var(--space-l) 0;
    }
  }

  section[aria-label="Prozess"] dl {
    display: grid;
    grid-gap: var(--space-xl);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 25ch), 1fr));
    justify-items: center;
  }

  section[aria-label="Prozess"] .container p:last-child {
    color: var(--color-neutral-900);
    font-size: var(--step-1);
    margin-top: var(--space-xl);
    max-width: 100%;
    text-align: center;
  }

  /* Section 3 */

  section[aria-label="Leistungen"] {
    background: var(--color-light-cream-50);
  }

  section[aria-label="Leistungen"] h2 {
    margin: 0;
  }

  .img-container {
    background: var(--color-light-cream-100);
    border-radius: 8px;
    padding: var(--space-m);
  }

  .img-container img {
    margin: 0 auto;
  }

  section[aria-label="Leistungen"] ul {
    display: grid;
    grid-gap: var(--space-l);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20ch), 1fr));
    margin-top: var(--space-l);
  }

  section[aria-label="Leistungen"] p {
    font-size: var(--step-2);
    margin: var(--space-xs) auto 0 auto;
    text-align: center;
  }
</style>
