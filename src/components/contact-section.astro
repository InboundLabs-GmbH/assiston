---
import { Image } from "astro:assets";

// import ErrorMessage from "@components/utils/ErrorMessage.astro";

import phone from "@images/contact/illustrations/1-phone.svg";
import email from "@images/contact/illustrations/2-email.svg";
import address from "@images/contact/illustrations/3-address.svg";
import hours from "@images/contact/illustrations/4-hours.svg";

const items = [
  {
    src: phone,
    title: "Telefon",
    description: `<a href="tel:+4922129297380">+49 221 29 29 73 80</a>`,
  },
  {
    src: email,
    title: "E-Mail",
    description: `<a href="mailto:info@deinassistenzdienst.de">info@deinassistenzdienst.de</a>`,
  },
  {
    src: address,
    title: "Anschrift",
    description:
      "Dein Assistenzdienst GmbH <br /> Robert-Perthel-Straße 79 <br /> 50739 Köln",
  },
  { src: hours, title: "Öffnungs­zeiten", description: "9 Uhr bis 17 Uhr" },
];
---

<section aria-label="Kontakt">
  <div class="container">
    <h2>Kontaktieren Sie uns</h2>

    <p>
      Haben wir Ihr Interesse geweckt? Dann kontaktieren Sie uns über das
      Formular oder rufen Sie uns an, um mehr über die Assistenzhilfe zu
      erfahren.
    </p>

    <dl>
      {
        items.map(({ src, title, description }) => (
          <div>
            <div class="img-container">
              <Image alt="" src={src} />
            </div>
            <div class="text-container">
              <dt class="highlight">{title}</dt>
              <dd set:html={description} />
            </div>
          </div>
        ))
      }
    </dl>

    <!-- TODO Add it after official launch? -->

