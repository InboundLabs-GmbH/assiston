---
import { Image } from "astro:assets";

import phone from "@images/contact/illustrations/1-phone.svg";
import email from "@images/contact/illustrations/2-email.svg";
import address from "@images/contact/illustrations/3-address.svg";
import hours from "@images/contact/illustrations/4-hours.svg";

const items = [
  {
    src: phone,
    title: "Telefon",
    description: `<a href="tel:093146621230">0931 4662 1230</a>`,
  },
  {
    src: email,
    title: "E-Mail",
    description: `<a href="mailto:info@assistenzhilfe.de">info@assistenzhilfe.de</a>`,
  },
  {
    src: address,
    title: "Anschrift",
    description:
      "Assistenzhilfe Assiston <br /> Pleichertorstraße 3 <br /> 97070 Würzburg",
  },
  { src: hours, title: "Öffnungs­zeiten", description: "9 Uhr bis 16 Uhr" },
];
---

<section aria-label="Kontakt">
  <div class="container">
    <h2>Kontaktieren Sie uns</h2>

    <p>
      Haben wir Ihr Interesse geweckt? Dann kontaktieren Sie uns über das
      Formular oder rufen Sie uns an, um mehr über die Assistenzhilfe zu
      erfahren.
    </p>

    <dl>
      {
        items.map(({ src, title, description }) => (
          <div>
            <div class="img-container">
              <Image alt="" src={src} />
            </div>
            <div class="text-container">
              <dt class="highlight">{title}</dt>
              <dd set:html={description} />
            </div>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  section {
    background: var(--color-deep-burgundy-500);
    color: var(--color-light-cream-50);
  }

  h2,
  dt,
  .error {
    color: var(--color-light-cream-50);
    font-family: "Lexend Light", Geneva, Tahoma, sans-serif;
  }

  dl {
    display: grid;
    grid-gap: var(--space-l);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20ch), 1fr));
    margin-top: var(--space-2xl);
  }

  dd {
    margin: 0;
  }

  .img-container {
    background: var(--color-deep-burgundy-300);
    border-radius: 8px;
    padding: var(--space-m);
  }

  .img-container img {
    margin: 0 auto;
  }

  .text-container {
    text-align: center;
    margin-top: var(--space-xs);
  }
</style>
