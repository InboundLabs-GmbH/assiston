---
import WorkInProgress from "@components/utils/WorkInProgress.astro";

import Layout from "@layouts/Layout.astro";
import HeroSection from "@components/hero-section.astro";

import { Image } from "astro:assets";
import heroImage from "@images/hero-image-index.png";

import home from "@images/illustrations/index/home.svg";
import hobby from "@images/illustrations/index/hobby.svg";
import study from "@images/illustrations/index/study.svg";
import work from "@images/illustrations/index/work.svg";

import enquiry from "@images/illustrations/index/1-enquiry.svg";
import check from "@images/illustrations/index/2-check.svg";
import goals from "@images/illustrations/index/3-goals.svg";
import payment from "@images/illustrations/index/4-payment.svg";

const gallery = [
  { src: home, title: "Arbeit" },
  { src: hobby, title: "Freizeit" },
  { src: study, title: "Schule / Studium" },
  { src: work, title: "Zuhause" },
];

const steps = [
  {
    src: enquiry,
    title: "1. Antrag­stellung",
    description:
      "Die Antragstellung erfolgt nur bei einem Leistungsträger. s. Sozialgesetzbuch 9, Paragraph 29 (SGB IX, §29) <br /> <br /> “Auf Antrag der Leistungsberechtigten werden Leistungen zur Teilhabe durch die Leistungsform eines persönlichen Budgets ausgeführt, um den Leistungsberechtigten in eigener Verantwortung ein möglichst selbstbestimmtes Leben zu ermöglichen.” <br /> <br /> Wir unterstützen Sie bei der Antragstellung beim entsprechenden Leistungsträger.",
  },
  {
    src: check,
    title: "2. Prü­fung des An­spruchs",
    description:
      "Der jeweilige Leistungsträger prüft deinen Anspruch und führt eine Bedarfsermittlung durch. Dabei wird ermittelt, welche Unterstützung Sie benötigen und wie hoch das Persönliche Budget ausfällt.",
  },
  {
    src: goals,
    title: "3. Zielver­einbarung",
    description:
      "Dies ist die Grundlage für den Bewilligungsbescheid und muss von beiden Parteien unterschrieben werden.",
  },
  {
    src: payment,
    title: "4. Auszahl­ung des Persön­lichen Budgets",
    description:
      "Im besten Fall übernehmen wir direkt mit dem Kostenträger die Abrechnung, damit Sie keinen bürokratischen Aufwand haben.",
  },
];

const team = [
  {
    title: "Team­koordination & Einsatz­planung",
    description:
      "Wir erstellen monatliche Dienst- und Backup-Pläne und berücksichtigen dabei Ihre Wünsche und die der Assistent*innen.",
  },
  {
    title: "Team­sitzung",
    description:
      "Regelmäßige Teamtreffen stärken das Zusammengehörigkeitsgefühl und verbessern die Kommunikation.",
  },
  {
    title: "Büro­kratie",
    description:
      "Wir übernehmen den gesamten administrativen Teil – von der Buchhaltung bis zur Lohnabrechnung",
  },
];
---

<Layout title="Assiston e.V. - Startseite">
  <!-- <HeroSection
    heading="Herzlich Will­kommen"
    kicker="bei Assiston Assistenzhilfe"
    src={heroImage}
  /> -->

  <main id="main">
    <div class="container">
      <section aria-label="Assistenz">
        <div>
          <h2>Persön&shy;liche Assis&shy;tenz</h2>

          <p>
            Wenn Sie von einem Persönlichen Budget profitieren, können Sie
            unsere Dienste ganz einfach in Anspruch nehmen:
          </p>

          <a href="/persoenliches-budget">Persönliches Budget</a>

          <p>
            Unser Assistenzdienst ist dazu da, um Ihnen das Leben unabhängiger
            und selbstbestimmter zu machen und können Ihren gesamten
            Lebensbereich umfassen. Die Persönliche Assistent*innen unterstützen
            Sie dabei.
          </p>

          <p>
            Die Aufgaben können dabei vielfältig sein und der Umfang richtet
            sich nach Ihrem individuellen Bedarf.
          </p>
        </div>

        <div>
          <WorkInProgress
            text="Habe den Text etwas angepasst, da es sich hier um eine Auflistung handelt. Beim Zweiten Punkt muss erläutert werden, mit wem kommuniziert wird."
          />

          <h3>Wir bieten Hilfe an bei:</h3>

          <ul>
            <li>Kleinen Botengängen</li>
            <li>Der Kommunikation (mit wem?)</li>
            <li>Haushalts- und Pflegetätigkeiten</li>
            <li>Ausflügen in den Urlaub</li>
            <li>24-Stunden-Betreuung</li>
          </ul>
        </div>
      </section>

      <section aria-label="Unterstützung">
        <h2>Be&shy;rei&shy;che der Un&shy;ter&shy;stüt&shy;zung</h2>

        <ul class="gallery" role="list">
          {
            gallery.map(({ src, title }) => (
              <li>
                <Image alt="" src={src} />
                <div class="highlight">{title}</div>
              </li>
            ))
          }
        </ul>

        <dl>
          {
            steps.map(({ src, title, description }) => (
              <div class="card-wrapper">
                <Image alt="" src={src} />
                <div>
                  <dt class="highlight">{title}</dt>
                  <dd set:html={description} />
                </div>
              </div>
            ))
          }
        </dl>

        <section aria-label="Team">
          <h2>Dein Team</h2>

          <p>
            Nachdem der Antrag genehmigt wurde, sorgen wir für die
            Zusammenstellung Ihres Teams. Dabei steht die Sympathie zwischen
            Ihnen und den Assistent*innen an oberster Stelle.
          </p>

          <dl>
            {
              team.map(({ title, description }) => (
                <div class="item">
                  <dt class="highlight">{title}</dt>
                  <dd>{description}</dd>
                </div>
              ))
            }
          </dl>
        </section>
      </section>
    </div>
  </main>

  <style>
    /* General */

    dl {
      display: grid;
      grid-gap: var(--space-m);
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 30ch), 1fr));
    }

    dd {
      margin: 0;
    }

    /* Section 1 */

    section[aria-label="Assistenz"] {
      display: grid;
      grid-gap: var(--space-m);
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 50ch), 1fr));
    }

    section[aria-label="Assistenz"] p:nth-of-type(1) {
      margin-bottom: var(--space-l);
    }

    section[aria-label="Assistenz"] p:nth-of-type(2) {
      margin-top: var(--space-l);
    }

    section[aria-label="Assistenz"] a {
      background: var(--color-terra-cotta-500);
      border-radius: var(--border-radius);
      color: var(--color-light-cream-50);
      outline-color: var(--color-terra-cotta-500);
      padding: var(--space-2xs);
      text-decoration: none;
    }

    /* Section 2 - Gallery */

    section[aria-label="Unterstützung"] h2 {
      margin-top: var(--space-l);
    }

    .gallery {
      display: grid;
      grid-gap: var(--space-m);
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 20ch), 1fr));
      justify-items: center;
      margin-top: var(--space-l);
    }

    .gallery li {
      text-align: center;
      max-width: fit-content;
    }

    .gallery .highlight {
      font-size: var(--step-2);
      margin-top: var(--space-s);
    }

    /* Section 2 - Steps */

    section[aria-label="Unterstützung"] dl {
      margin-top: var(--space-2xl);
    }

    .card-wrapper {
      height: fit-content;
    }

    .card-wrapper img {
      margin-bottom: -4rem;
      padding: 0 var(--space-m);
      width: 100%;
    }

    .card-wrapper div {
      background: var(--color-light-cream-50);
      padding: var(--space-xl) var(--space-m) var(--space-m) var(--space-m);
    }

    .card-wrapper .highlight {
      color: var(--color-deep-burgundy-500);
    }

    .card-wrapper dd {
      margin-top: var(--space-s);
    }

    /* Section 3 */

    section[aria-label="Team"] .highlight {
      font-size: var(--step-2);
    }

    section[aria-label="Team"] dd {
      margin-top: var(--space-s);
    }
  </style>
</Layout>
