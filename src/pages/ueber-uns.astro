---
import { useStoryblokApi } from "@storyblok/astro";
import StoryblokComponent from "@storyblok/astro/StoryblokComponent.astro";

import Layout from "@layouts/Layout.astro";

import { Image } from "astro:assets";

import dog from "@images/about-us/1-dog.jpeg";
import group from "@images/about-us/2-group.jpeg";
import walking from "@images/about-us/3-walking.jpeg";
import armsUp from "@images/about-us/4-arms-up.jpeg";
import selfie from "@images/about-us/5-selfie.jpeg";

const storyblokApi = useStoryblokApi();
const { data } = await storyblokApi.get("cdn/stories/ueber-uns", {
  version: "draft",
});
const story = data.story;
---

<Layout title="Über uns - Assiston e.V.">
  <StoryblokComponent blok={story.content.body[0]} />

  <main id="main">
    <div class="first">
      <div>
        <StoryblokComponent blok={story.content.body[1]} />
      </div>
      <Image alt="" class="image" src={dog} width={560} />
    </div>

    <div class="second">
      <div>
        <Image alt="" class="image" src={group} />
        <div class="flex">
          <StoryblokComponent blok={story.content.body[2]} />
        </div>
        <div class="gallery">
          <Image alt="" class="image" src={walking} />
          <Image alt="" class="image" src={armsUp} />
          <Image alt="" class="image" src={selfie} />
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  /* General */
  h2 {
    font-size: var(--step-3);
  }

  .first,
  .second > div {
    margin: 0 auto;
    max-width: 1440px;
    padding: var(--space-2xl) var(--space-m);
  }

  /* Section 1 */

  .first {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
    justify-content: center;
  }

  .first > div {
    width: fit-content;

    h2 {
      max-width: 20ch;
    }

    p {
      max-width: 40ch;
    }
  }

  /* Section 2 */

  .second {
    background: var(--color-light-cream-50);
  }

  .flex {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
    justify-content: space-between;
    margin-top: var(--space-xl);
  }

  .flex {
    p {
      margin: 0;
      max-width: 40ch;
    }
  }

  /* Gallery */
  .gallery {
    display: grid;
    grid-gap: var(--space-m);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 50ch), 1fr));
    margin-top: var(--space-xl);
  }

  .gallery img {
    align-self: stretch;
    object-fit: cover;
  }
</style>
