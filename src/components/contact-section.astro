<style>
  section {
    background: var(--color-deep-burgundy-500);
    color: var(--color-light-cream-50);
  }

  h2,
  dt,
  .error {
    color: var(--color-light-cream-50);
    font-family: "Lexend Light", Geneva, Tahoma, sans-serif;
  }

  dl {
    display: grid;
    grid-gap: var(--space-l);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20ch), 1fr));
    margin-top: var(--space-2xl);
  }

  dd {
    margin: 0;
  }

  .img-container {
    background: var(--color-deep-burgundy-300);
    border-radius: 8px;
    padding: var(--space-m);
  }

  .img-container img {
    margin: 0 auto;
  }

  .text-container {
    text-align: center;
    margin-top: var(--space-xs);
  }

  /* Form */

  .container h2:nth-of-type(2) {
    margin: var(--space-l) auto;
    width: fit-content;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    margin: 0 auto;
    max-width: calc(var(--max-width) / 2);
  }

  input,
  textarea {
    margin-top: var(--space-xs);
  }

  input,
  textarea {
    background: transparent;
    border: 2px solid var(--color-light-cream-50);
    border-radius: 8px;
    font-family: "Lexend Light", Geneva, Tahoma, sans-serif;
    font-size: var(--step-1);
  }

  input,
  textarea {
  }

  textarea {
    resize: vertical;
  }

  .label-and-input {
    display: flex;
    flex-direction: column;
  }

  .form-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
    justify-content: end;
  }

  button[type="reset"],
  button[type="submit"] {
    border-radius: 8px;
    padding: var(--space-2xs);
  }

  button[type="reset"] {
    background: transparent;
    border: 1px solid var(--color-light-cream-50);
  }

  button[type="submit"] {
    background: var(--color-terra-cotta-500);
    border: 1px solid var(--color-light-cream-50);
  }
</style>
