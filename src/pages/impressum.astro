<style>
  h1 {
    color: var(--color-deep-burgundy-500);
    text-align: center;
  }

  h2,
  h3 {
    hyphens: manual;
    margin-top: var(--space-m);
  }

  dl {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }

