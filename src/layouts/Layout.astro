---
import "@styles/global.css";
import "@styles/variables.css";
import "@styles/reset.css";

import SkipLink from "@components/utils/SkipLink.astro";
import Navigation from "@components/navigation.astro";
import ContactSection from "@components/contact-section.astro";
import Footer from "@components/footer.astro";

import { ClientRouter } from "astro:transitions";

export interface Props {
  noContactSection?: boolean;
  title: string;
}

const { noContactSection, title } = Astro.props;

const metaData = {
  keywords: "inklusion, barrierefreiheit, teilhabe, assistenz",
  description:
    "Beratung für Menschen mit Behinderung und deren Angehörige zu den Themen Teilhabe, Wohnen, Freizeit, Assistenz und Vereine.",
  imageType: "image/png",
  imageWidth: "1600",
  imageHeight: "882",
  type: "website",
  siteName: "Assiston e.V.",
  twitterCard: "summary_large_image",
};

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL("/seo.png", Astro.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="keywords" content={metaData.keywords} />
    <meta name="description" content={metaData.description} />
    <link rel="icon" type="image/svg+xml" href="/favicon-astronaut.svg" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={metaData.type} />
    <meta property="og:site_name" content={metaData.siteName} />
    <meta property="og:description" content={metaData.description} />
    <meta property="og:title" content={title} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:type" content={metaData.imageType} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:image:width" content={metaData.imageWidth} />
    <meta property="og:image:height" content={metaData.imageHeight} />
    <meta name="twitter:card" content={metaData.twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaData.description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content={title} />
    <ClientRouter />
  </head>
  <body>
    <SkipLink />
    <Navigation />
    <slot />
    {!noContactSection ? <ContactSection /> : null}
    <Footer />
  </body>
</html>
