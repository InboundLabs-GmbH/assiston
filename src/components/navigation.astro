---
const links = [
  { href: "/", label: "Startseite" },
  { href: "/persoenliches-budget", label: "Persönliches Budget" },
  { href: "/leistungen", label: "Leistungen" },
  { href: "/stellenangebote", label: "Stellenangebote" },
  { href: "/ueber-uns", label: "Über uns" },
  // { href: "/faq", label: "FAQ" },
  { href: "/kontakt", label: "Kontakt" },
];
---

<header>
  <nav aria-label="Primär">
    <ul role="list">
      {
        links.map(({ href, label }) => (
          <li>
            <a
              href={href}
              aria-current={Astro.url.pathname === href ? "page" : undefined}
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  ul {
    display: flex;
    gap: 1rem;
    margin: 0;
    padding: 1rem;
  }

  a {
    text-decoration: none;
  }

  a[aria-current="page"] {
    text-decoration-color: var(--color-secondary-orange);
    text-decoration-line: underline;
    text-decoration-thickness: 4px;
  }
</style>
