---
import Layout from "@layouts/Layout.astro";
import HeroSection from "@components/hero-section.astro";
import ExternalLink from "@components/utils/ExternalLink.astro";

import { Image } from "astro:assets";
import heroImage from "@images/hero-image-personal-budget.png";

import galleryOne from "@images/personal-budget/1-personal-budget.svg";
import galleryTwo from "@images/personal-budget/2-personal-budget.svg";
import galleryThree from "@images/personal-budget/3-personal-budget.svg";

import enquiryOne from "@images/personal-budget/enquiry/1-enquiry.svg";
import enquiryTwo from "@images/personal-budget/enquiry/2-enquiry.svg";
import enquiryThree from "@images/personal-budget/enquiry/3-enquiry.svg";
import enquiryFour from "@images/personal-budget/enquiry/4-enquiry.svg";
import enquiryFive from "@images/personal-budget/enquiry/5-enquiry.svg";

import serviceOne from "@images/personal-budget/services/1-services.svg";
import serviceTwo from "@images/personal-budget/services/2-services.svg";
import serviceThree from "@images/personal-budget/services/3-services.svg";
import serviceFour from "@images/personal-budget/services/4-services.svg";
import serviceFive from "@images/personal-budget/services/5-services.svg";
import serviceSix from "@images/personal-budget/services/6-services.svg";

const gallery = [
  {
    src: galleryOne,
    title: "Men­schen mit Behinderungen",
    description:
      "Jeder behinderte oder von Behinderung bedrohte Mensch, egal wie schwer die Behinderung ist.",
  },
  {
    src: galleryTwo,
    title: "Unter­stützungs­bedürftige",
    description:
      "Menschen, die aufgrund ihrer Behinderung, das Geld nicht alleine verwalten können.",
  },
  {
    src: galleryThree,
    title: "Elternhilfe",
    description: "Eltern für ihre behinderten Kinder.",
  },
];

const process = [
  {
    src: enquiryOne,
    title: "Beratungsgespräch",
    description: "bei einem Kostenträger oder einer EUTB.",
  },
  {
    src: enquiryTwo,
    title: "Antragstellung",
    description:
      "Der erste Schritt ist, einen Antrag bei Ihrer zuständigen Sozialbehörde oder dem Träger der Eingliederungshilfe zu stellen.",
  },
  {
    src: enquiryThree,
    title: "Bedarfsfeststellung",
    description:
      "In der Regel wird ein Bedarfsgutachten erstellt, um festzustellen, welche Unterstützungsleistungen für Sie erforderlich sind.",
  },
  {
    src: enquiryFour,
    title: "Zielvereinbarung",
    description:
      "Die Zielvereinbarung muss zu Ihnen passen und Sie müssen die Ziele auch schaffen können.",
  },
  {
    src: enquiryFive,
    title: "Bewilligung und Bescheid",
    description:
      "Wenn Ihr Antrag genehmigt wird, erhalten Sie das Persönliche Budget, welches Sie dann nutzen können, um Ihre gewünschte Dienstleistung zu finanzieren.",
  },
];

const services = [
  { src: serviceOne, title: "Wohnen und Alltagsunter­stützung" },
  { src: serviceTwo, title: "Grundpflege" },
  { src: serviceThree, title: "Freizeit und Kultur" },
  { src: serviceFour, title: "Urlaub" },
  { src: serviceFive, title: "Arbeit, Ausbildung, Studium & Schule" },
  { src: serviceSix, title: "Begleitung zu Terminen" },
];
---

<Layout title="Persönliches Budget - Assiston e.V.">
  <!-- <HeroSection
    heading="Das Persön­liche Budget"
    kicker="Was ist das Persönliche Budget und wie kann ich es erhalten?"
    src={heroImage}
  /> -->

  <main id="main">
    <section aria-label="Allgemein">
      <div class="container">
        <p class="highlight">
          Ein Persönliches Budget ist eine wichtige finanzielle Unterstützung.
        </p>
        <p>
          Das Persönliche Budget hilft, ein selbstbestimmtes Leben zu führen.
          Sie können selbst entscheiden, welche Assistenzleistungen Sie
          benötigen.
        </p>

        <h2>Wer kann es beantragen?</h2>

        <dl class="gallery">
          {
            gallery.map(({ src, title, description }) => (
              <div>
                <Image alt="" src={src} />
                <dt class="highlight">{title}</dt>
                <dd>{description}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section aria-label="Prozess">
      <div class="container">
        <h2>Wo kann ich es beantragen?</h2>

        <p>
          Sie schreiben einen Antrag für das Persönliche Budget und reichen
          diesen bei ihrer zuständigen Behörde ein. Wir helfen Ihnen dabei, den
          richtigen Kostenträger für Sie zu finden. Hier können Sie mehr
          erfahren: <ExternalLink
            href="https://www.bmas.de/DE/Soziales/Teilhabe-und-Inklusion/Rehabilitation-und-Teilhabe/Persoenliches-Budget/Fragen-und-Antworten-DGS/faq-persoenliches-budget.html"
            name="Fragen und Antworten zum persönlichen Budget"
          />
        </p>

        <h3>Ablauf des Verfahrens:</h3>

        <dl>
          {
            process.map(({ src, title, description }, index) => (
              <div>
                <div class="number-and-image">
                  <div aria-hidden="true" class="number">
                    {index + 1}
                  </div>
                  <Image alt="" src={src} width={300} />
                </div>
                <dt class="highlight">{title}</dt>
                <dd>{description}</dd>
              </div>
            ))
          }
        </dl>

        <p class="highlight">
          Wird das Persönliche Budget ausschließlich durch die
          Pflegeversicherung erbracht, ist keine Zielvereinbarung notwendig.
        </p>
      </div>
    </section>

    <section aria-label="Leistungen">
      <div class="container">
        <h2>Welche Leistungen sind für Sie hier enthalten?</h2>
        <ul role="list">
          {
            services.map(({ src, title }) => (
              <li>
                <div class="img-container">
                  <Image alt="" src={src} />
                </div>
                <p class="highlight">{title}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* General */

  dd {
    margin: 0;
    max-width: 30ch;
  }

  /* Section 1 */

  section[aria-label="Allgemein"] {
    background: var(--color-light-cream-50);
  }

  section[aria-label="Allgemein"] h2 {
    margin-top: var(--space-l);
  }

  .highlight {
    margin: 0;
    max-width: 30ch;
  }

  .gallery {
    display: grid;
    grid-gap: var(--space-m);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20ch), 1fr));
    justify-items: center;
    width: 100%;
  }

  .gallery dt {
    text-align: center;
  }

  .gallery div {
    display: flex;
    flex-direction: column;
    flex-wrap: wrap;
    gap: var(--space-m);
  }

  /* Section 2 */

  section[aria-label="Prozess"] h2 {
    margin: 0;
  }

  section[aria-label="Prozess"] h3 {
    margin-top: var(--space-l);
  }

  section[aria-label="Prozess"] dl {
    display: grid;
    grid-gap: var(--space-xl);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 25ch), 1fr));
    justify-items: center;
  }

  section[aria-label="Prozess"] dl div {
    max-width: 400px;
  }

  section[aria-label="Prozess"] dl div .highlight {
    font-size: var(--step-2);
    margin-bottom: var(--space-xs);
  }

  section[aria-label="Prozess"] dl div img {
    width: 100%;
  }

  section[aria-label="Prozess"] .container p:last-child {
    color: var(--color-neutral-900);
    font-size: var(--step-1);
    margin-top: var(--space-xl);
    max-width: 100%;
    text-align: center;
  }

  .number-and-image {
    border-top: 3px solid var(--color-cal-poly-green-500);
    position: relative;
  }

  .number {
    align-items: center;
    background: var(--color-cal-poly-green-500);
    color: var(--color-light-cream-50);
    display: flex;
    font-size: var(--step-3);
    justify-content: center;
    padding: var(--space-m);
    position: absolute;
    width: var(--step-1);
    height: var(--step-1);
    top: 0;
    left: 0;
  }

  /* Section 3 */

  section[aria-label="Leistungen"] {
    background: var(--color-light-cream-50);
  }

  section[aria-label="Leistungen"] h2 {
    margin: 0;
  }

  .img-container {
    background: var(--color-light-cream-100);
    border-radius: 8px;
    padding: var(--space-m);
  }

  .img-container img {
    margin: 0 auto;
  }

  section[aria-label="Leistungen"] ul {
    display: grid;
    grid-gap: var(--space-l);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20ch), 1fr));
    margin-top: var(--space-l);
  }

  section[aria-label="Leistungen"] p {
    font-size: var(--step-2);
    margin: var(--space-xs) auto 0 auto;
    text-align: center;
  }
</style>
