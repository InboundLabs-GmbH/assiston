---
import { useStoryblokApi } from "@storyblok/astro";
import StoryblokComponent from "@storyblok/astro/StoryblokComponent.astro";

import Layout from "@layouts/Layout.astro";

import { Image } from "astro:assets";

import home from "@images/illustrations/index/home.svg";
import hobby from "@images/illustrations/index/hobby.svg";
import study from "@images/illustrations/index/study.svg";
import work from "@images/illustrations/index/work.svg";

import enquiry from "@images/illustrations/index/1-enquiry.svg";
import check from "@images/illustrations/index/2-check.svg";
import goals from "@images/illustrations/index/3-goals.svg";
import payment from "@images/illustrations/index/4-payment.svg";

const storyblokApi = useStoryblokApi();
const { data } = await storyblokApi.get("cdn/stories/home", {
  version: "draft",
});

const story = data.story;

const gallery = [
  { src: home, title: "Arbeit" },
  { src: hobby, title: "Freizeit" },
  { src: study, title: "Schule / Studium" },
  { src: work, title: "Zuhause" },
];
---

<Layout title="Assiston e.V. - Startseite">
  <StoryblokComponent blok={story.content.body[0]} />

  <main id="main">
    <div class="container">
      <section aria-label="Assistenz">
        <div>
          <StoryblokComponent blok={story.content.body[1]} />

          <StoryblokComponent blok={story.content.body[2]} />

          <a href="/persoenliches-budget">Persönliches Budget</a>

          <StoryblokComponent blok={story.content.body[3]} />

          <StoryblokComponent blok={story.content.body[4]} />
        </div>

        <div>
          <StoryblokComponent blok={story.content.body[5]} />

          <StoryblokComponent blok={story.content.body[6]} />
        </div>
      </section>

      <section aria-label="Unterstützung">
        <StoryblokComponent blok={story.content.body[7]} />

        <ul class="gallery" role="list">
          {
            gallery.map(({ src, title }) => (
              <li>
                <Image alt="" src={src} />
                <div class="highlight">{title}</div>
              </li>
            ))
          }
        </ul>

        <dl>
          <div class="card-wrapper">
            <Image alt="" src={enquiry} />
            <div>
              <StoryblokComponent blok={story.content.body[8]} />
            </div>
          </div>
          <div class="card-wrapper">
            <Image alt="" src={check} />
            <div>
              <StoryblokComponent blok={story.content.body[9]} />
            </div>
          </div>
          <div class="card-wrapper">
            <Image alt="" src={goals} />
            <div>
              <StoryblokComponent blok={story.content.body[10]} />
            </div>
          </div>
          <div class="card-wrapper">
            <Image alt="" src={payment} />
            <div>
              <StoryblokComponent blok={story.content.body[11]} />
            </div>
          </div>
        </dl>

        <section aria-label="Team">
          <StoryblokComponent blok={story.content.body[12]} />

          <StoryblokComponent blok={story.content.body[13]} />

          <dl>
            <StoryblokComponent blok={story.content.body[14]} />
            <StoryblokComponent blok={story.content.body[15]} />
            <StoryblokComponent blok={story.content.body[16]} />
          </dl>
        </section>
      </section>
    </div>
  </main>

  <style>
    /* General */

    dl {
      display: grid;
      grid-gap: var(--space-m);
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 30ch), 1fr));
    }

    dd {
      margin: 0;
    }

    /* Section 1 */

    section[aria-label="Assistenz"] {
      display: grid;
      grid-gap: var(--space-m);
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 50ch), 1fr));
    }

    section[aria-label="Assistenz"] p:nth-of-type(1) {
      margin-bottom: var(--space-l);
    }

    section[aria-label="Assistenz"] p:nth-of-type(2) {
      margin-top: var(--space-l);
    }

    section[aria-label="Assistenz"] a {
      background: var(--color-terra-cotta-500);
      border-radius: var(--border-radius);
      color: var(--color-light-cream-50);
      outline-color: var(--color-terra-cotta-500);
      padding: var(--space-2xs);
      text-decoration: none;
    }

    /* Section 2 - Gallery */

    section[aria-label="Unterstützung"] h2 {
      margin-top: var(--space-l);
    }

    .gallery {
      display: grid;
      grid-gap: var(--space-m);
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 20ch), 1fr));
      justify-items: center;
      margin-top: var(--space-l);
    }

    .gallery li {
      text-align: center;
      max-width: fit-content;
    }

    .gallery .highlight {
      font-size: var(--step-2);
      margin-top: var(--space-s);
    }

    /* Section 2 - Steps */

    section[aria-label="Unterstützung"] dl {
      margin-top: var(--space-2xl);
    }

    .card-wrapper {
      height: fit-content;
    }

    .card-wrapper img {
      margin-bottom: -4rem;
      padding: 0 var(--space-m);
      width: 100%;
    }

    .card-wrapper div {
      background: var(--color-light-cream-50);
      padding: var(--space-xl) var(--space-m) var(--space-m) var(--space-m);
    }

    .card-wrapper .highlight {
      color: var(--color-deep-burgundy-500);
    }

    .card-wrapper dd {
      margin-top: var(--space-s);
    }
  </style>
</Layout>
