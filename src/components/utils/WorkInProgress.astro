---
export interface Props {
  text: string;
}

const { text } = Astro.props;
---

<article>
  <p>&#9758; {text} &#9756;</p>
</article>

<style>
  article {
    background: yellow;
    border: 5px dashed black;
    padding: var(--space-m);
    text-align: center;
    width: 100%;
  }

  p {
    color: black;
    font-size: var(--step-2);
    margin: 0;
  }
</style>
