---
import { useStoryblokApi } from "@storyblok/astro";
import StoryblokComponent from "@storyblok/astro/StoryblokComponent.astro";

import Layout from "@layouts/Layout.astro";

import { Image } from "astro:assets";

import carousel from "@images/services/1-carousel.jpeg";

import diagram from "@images/services/6-diagram.svg";

import listItemOne from "@images/services/7-list-item.svg";
import listItemTwo from "@images/services/8-list-item.svg";
import listItemThree from "@images/services/9-list-item.svg";
import listItemFour from "@images/services/10-list-item.svg";
import listItemFive from "@images/services/11-list-item.svg";

const storyblokApi = useStoryblokApi();
const { data } = await storyblokApi.get("cdn/stories/leistungen", {
  version: "draft",
});
const story = data.story;

const listItems = [
  { src: listItemOne, title: "Eigener Dienstplan" },
  { src: listItemTwo, title: "Individuelle Dienstzeiten" },
  { src: listItemThree, title: "Festes Team" },
  { src: listItemFour, title: "Verwaltungsaufgaben" },
  { src: listItemFive, title: "Hilfe bei Antragstellung" },
];
---

<Layout title="Leistungen - Assiston e.V.">
  <StoryblokComponent blok={story.content.body[0]} />

  <main id="main">
    <section aria-label="Ablauf">
      <div class="container">
        <div class="intro">
          <div class="intro-text">
            <StoryblokComponent blok={story.content.body[1]} />
          </div>

          <Image alt="" src={carousel} width={560} />
        </div>

        <dl>
          <StoryblokComponent blok={story.content.body[2]} />
          <StoryblokComponent blok={story.content.body[3]} />
          <StoryblokComponent blok={story.content.body[4]} />
          <StoryblokComponent blok={story.content.body[5]} />
        </dl>
      </div>
    </section>

    <section aria-label="Details">
      <div class="container">
        <h2>Unser Service für Sie!</h2>

        <div>
          <ul role="list">
            {
              listItems.map(({ src, title }) => (
                <li>
                  <Image alt="" src={src} />
                  {title}
                </li>
              ))
            }
          </ul>

          <Image alt="" src={diagram} />
        </div>
      </div>
    </section>

    <section aria-label="Umsetzung">
      <div class="container">
        <StoryblokComponent blok={story.content.body[6]} />
      </div>
    </section>
  </main>
</Layout>

<style>
  /* General */

  .container,
  dl {
    margin: 0 auto;
    max-width: var(--max-width);
  }

  dd {
    margin: var(--space-xs) 0 0 0;
  }

  /* Section 1 */

  section[aria-label="Ablauf"] {
    background: var(--color-light-cream-50);
  }

  .intro {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-l);
    justify-content: space-evenly;
  }

  .intro img {
    border-radius: 8px;
    height: auto;
  }

  .intro-text {
    max-width: 90ch;
  }

  .intro-text h2 {
    font-size: var(--step-3);
  }

  /* Process section */

  dl {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
    margin-top: var(--space-2xl);
  }

  /* .details-text {
    background: var(--color-neutral-50);
    display: flex;
    flex-direction: column;
    padding: var(--space-l);
    max-width: 50ch;
  } */

  /* .process-container {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    justify-content: center;
  }

  .process-container:nth-child(even) {
    flex-direction: row-reverse;
  } */

  /* Section 2 */

  section[aria-label="Details"] h2 {
    margin-bottom: var(--space-l);
  }

  section[aria-label="Details"] ul {
    display: flex;
    flex-direction: column;
    flex-wrap: wrap;
    font-size: var(--step-2);
    gap: var(--space-l);
  }

  section[aria-label="Details"] ul li {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  section[aria-label="Details"] ul li:nth-child(2) {
    color: var(--color-cal-poly-green-500);
  }

  section[aria-label="Details"] ul li:nth-child(3) {
    color: var(--color-deep-burgundy-500);
  }

  section[aria-label="Details"] ul li:nth-child(4) {
    color: var(--color-terra-cotta-500);
  }

  section[aria-label="Details"] ul li:last-child {
    color: var(--color-terra-cotta-800);
  }

  section[aria-label="Details"] div {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    justify-content: center;
  }

  /* Section 3 */

  section[aria-label="Umsetzung"] {
    background: var(--color-light-cream-50);
  }

  section[aria-label="Umsetzung"] .container {
    width: fit-content;
  }

  .action-container {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
    margin-top: var(--space-l);
  }

  .action-container .highlight {
    max-width: 20ch;
  }

  .action-container p {
    margin: 0;
  }

  .action-container div p {
    max-width: 45ch;
  }

  .action-container div p:last-child {
    margin-top: var(--space-m);
  }
</style>
