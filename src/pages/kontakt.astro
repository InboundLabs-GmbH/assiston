---
import { useStoryblokApi } from "@storyblok/astro";
import StoryblokComponent from "@storyblok/astro/StoryblokComponent.astro";

import Layout from "@layouts/Layout.astro";

import { Image } from "astro:assets";

import group from "@images/contact/1-group.jpeg";

const storyblokApi = useStoryblokApi();
const { data } = await storyblokApi.get("cdn/stories/kontakt", {
  version: "draft",
});
const story = data.story;
---

<Layout title="Kontakt - Assiston e.V.">
  <StoryblokComponent blok={story.content.body[0]} />

  <main id="main">
    <div class="container">
      <div class="flex">
        <div>
          <StoryblokComponent blok={story.content.body[1]} />
        </div>
        <Image
          alt="Gruppe von Menschen stehen in einem Kreis und lachen miteinander"
          src={group}
          width={532}
        />
      </div>

      <div class="center">
        <StoryblokComponent blok={story.content.body[2]} />
      </div>
    </div>
  </main>
</Layout>

<style>
  .flex {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);

    h2 {
      font-size: var(--step-2);
      max-width: 30ch;
    }

    p {
      max-width: 45ch;
    }
  }

  img {
    border-radius: 8px;
    height: auto;
  }

  .center {
    margin-top: var(--space-xl);
    text-align: center;
  }
</style>
