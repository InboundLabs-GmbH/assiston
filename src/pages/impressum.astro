---
import { useStoryblokApi } from "@storyblok/astro";
import StoryblokComponent from "@storyblok/astro/StoryblokComponent.astro";

import Layout from "@layouts/Layout.astro";

const storyblokApi = useStoryblokApi();
const { data } = await storyblokApi.get("cdn/stories/impressum", {
  version: "draft",
});

const story = data.story;
---

<Layout title="Impressum - Assiston e.V.">
  <main id="main">
    <div class="container">
      <h1>Impressum</h1>

      <dl>
        <div>
          <dt>Adresse:</dt>
          <dd><StoryblokComponent blok={story.content.body[0]} /></dd>

          <div>
            <dt>Telefon:</dt>
            <dd>
              <StoryblokComponent blok={story.content.body[1]} />
            </dd>
          </div>

          <div>
            <dt>E-Mail:</dt>
            <dd>
              <StoryblokComponent blok={story.content.body[2]} />
            </dd>
          </div>

          <div>
            <dt>Vertreten durch:</dt>
            <dd><StoryblokComponent blok={story.content.body[3]} /></dd>
          </div>

          <div>
            <dt>Registereintrag:</dt>
            <dd><StoryblokComponent blok={story.content.body[4]} /></dd>
          </div>

          <div>
            <dt>Bildrechte:</dt>
            <dd><StoryblokComponent blok={story.content.body[5]} /></dd>
          </div>
        </div>

        <StoryblokComponent blok={story.content.body[6]} />
      </dl>
    </div>
  </main>

  <style>
    h1 {
      color: var(--color-deep-burgundy-500);
      text-align: center;
    }

    h2,
    h3 {
      hyphens: manual;
      margin-top: var(--space-m);
    }

    dl {
      display: flex;
      flex-direction: column;
      gap: var(--space-m);
    }

    dt {
      font-family: "Lexend Medium", Geneva, Tahoma, sans-serif;
    }
  </style>
</Layout>
