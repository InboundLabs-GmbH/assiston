---
import { storyblokEditable } from "@storyblok/astro";
import { Image } from "astro:assets";

const { blok } = Astro.props;
---

<div {...storyblokEditable(blok)}>
  <div class="number-and-image">
    <div aria-hidden="true" class="number">
      {blok.number}
    </div>
    <Image alt="" height={300} src={blok.image.filename} width={300} />
  </div>
  <dt class="highlight">{blok.title}</dt>
  <dd>{blok.description}</dd>
</div>

<style>
  dt {
    margin-top: var(--space-m);
  }

  dd {
    margin: 0;
  }

  div {
    max-width: 400px;
  }

  div .highlight {
    font-size: var(--step-2);
    margin-bottom: var(--space-xs);
  }

  div img {
    width: 100%;
  }

  .number-and-image {
    border-top: 3px solid var(--color-cal-poly-green-500);
    position: relative;
  }

  .number {
    align-items: center;
    background: var(--color-cal-poly-green-500);
    color: var(--color-light-cream-50);
    display: flex;
    font-size: var(--step-3);
    justify-content: center;
    padding: var(--space-m);
    position: absolute;
    width: var(--step-1);
    height: var(--step-1);
    top: 0;
    left: 0;
  }
</style>
