---
import { Image } from "astro:assets";

// TODO Switch out logo depending on theme
// import logoDark from "@images/logo-dark.svg";
import logoLight from "@images/logo-light.svg";

const links = [
  { href: "/", label: "Startseite", logo: true },
  { href: "/persoenliches-budget", label: "Persönliches Budget" },
  { href: "/leistungen", label: "Leistungen" },
  { href: "/stellenangebote", label: "Stellenangebote" },
  { href: "/ueber-uns", label: "Über uns" },
  // { href: "/faq", label: "FAQ" },
  { href: "/kontakt", special: true, label: "Kontakt" },
];
---

<header>
  <nav aria-label="Primär">
    <ul role="list">
      {
        links.map(({ href, special, label, logo }) => (
          <li>
            <a
              class={special ? "special" : null}
              href={href}
              aria-current={
                Astro.url.pathname === href || Astro.url.pathname === `${href}/`
                  ? "page"
                  : undefined
              }
            >
              {!logo ? (
                label
              ) : (
                <Image
                  alt="Assiston e.V. Startseite"
                  src={logoLight}
                  width={150}
                />
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  header {
    margin: 0 auto;
    max-width: var(--max-width);
  }

  /* Scrollbar */

  ul {
    align-items: center;
    block-size: auto;
    display: flex;
    gap: var(--space-xs);
    justify-content: space-around;
    overflow-x: auto;
    overflow-y: hidden;
    padding: var(--space-s) var(--space-2xs);
    scrollbar-color: var(--color-deep-burgundy-500) var(--color-light-cream-50);
  }

  ul::-webkit-scrollbar {
    block-size: 0.5rem;
  }

  ul::-webkit-scrollbar-track {
    background-color: var(--color-light-cream-50);
  }

  ul::-webkit-scrollbar-thumb {
    background-color: var(--color-deep-burgundy-500);
    background-image: var(--color-light-cream-50);
  }

  ul > * {
    flex: 0 0 auto;
  }

  ul > * + * {
    margin-inline-start: 1rem;
  }

  ul.overflowing {
    padding-block-end: 1rem;
  }

  /* Links */

  a {
    font-size: calc(var(--step-1) * 1.1);
    text-decoration: none;
  }

  a[aria-current="page"] {
    text-decoration-color: var(--color-terra-cotta-500);
    text-decoration-line: underline;
    text-decoration-thickness: 4px;
  }

  a[aria-current="page"]:is(.special) {
    background: var(--color-light-cream-50);
    color: var(--color-terra-cotta-500);
  }

  a:has(img):hover img,
  a:has(img):focus img,
  a:has(img):focus-visible img {
    outline: var(--outline-size) var(--outline-style) var(--outline-color);
    outline-offset: 5px;
  }

  .special {
    background: var(--color-terra-cotta-500);
    border-radius: 8px;
    color: var(--color-light-cream-50);
    padding: var(--space-2xs);
    outline-color: var(--color-terra-cotta-500);
  }
</style>
