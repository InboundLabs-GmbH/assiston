---
import Layout from "@layouts/Layout.astro";
import HeroSection from "@components/hero-section.astro";
import ExternalLink from "@components/utils/ExternalLink.astro";

import { Image } from "astro:assets";
import heroImage from "@images/hero-image-personal-budget.png";

import galleryOne from "@images/personal-budget/1-personal-budget.svg";
import galleryTwo from "@images/personal-budget/2-personal-budget.svg";
import galleryThree from "@images/personal-budget/3-personal-budget.svg";

import enquiryOne from "@images/personal-budget/enquiry/1-enquiry.svg";
import enquiryTwo from "@images/personal-budget/enquiry/2-enquiry.svg";
import enquiryThree from "@images/personal-budget/enquiry/3-enquiry.svg";
import enquiryFour from "@images/personal-budget/enquiry/4-enquiry.svg";
import enquiryFive from "@images/personal-budget/enquiry/5-enquiry.svg";

import serviceOne from "@images/personal-budget/services/1-services.svg";
import serviceTwo from "@images/personal-budget/services/2-services.svg";
import serviceThree from "@images/personal-budget/services/3-services.svg";
import serviceFour from "@images/personal-budget/services/4-services.svg";
import serviceFive from "@images/personal-budget/services/5-services.svg";
import serviceSix from "@images/personal-budget/services/6-services.svg";
---

<Layout title="Persönliches Budget - Assiston e.V.">
  <HeroSection
    heading="Das Persön­liche Budget"
    kicker="Was ist das Persönliche Budget und wie kann ich es erhalten?"
    src={heroImage}
  />

  <main id="main">
    <section aria-label="Allgemein">
      <div class="container">
        <div class="flex">
          <p class="highlight">
            Ein Persönliches Budget ist eine wichtige finanzielle Unterstützung.
          </p>
          <p>
            Das Persönliche Budget hilft, ein selbstbestimmtes Leben zu führen.
            Sie können selbst entscheiden, welche Assistenzleistungen Sie
            benötigen.
          </p>
        </div>

        <div class="flex">
          <h2>Wer kann es beantragen?</h2>

          <dl class="gallery">
            <div>
              <Image alt="" src={galleryOne} />
              <dt class="highlight">Men&shy;schen mit Behinderungen</dt>
              <dd>
                Jeder behinderte oder von Behinderung bedrohte Mensch, egal wie
                schwer die Behinderung ist.
              </dd>
            </div>

            <div>
              <Image alt="" src={galleryTwo} />
              <dt class="highlight">Unter&shy;stützungs&shy;bedürftige</dt>
              <dd>
                Menschen, die aufgrund ihrer Behinderung, das Geld nicht alleine
                verwalten können.
              </dd>
            </div>

            <div>
              <Image alt="" src={galleryThree} />
              <dt class="highlight">Elternhilfe</dt>
              <dd>Eltern für ihre behinderten Kinder.</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <section aria-label="Prozess">
      <div class="container">
        <h2>Wo kann ich es beantragen?</h2>

        <p>
          Sie schreiben einen Antrag für das Persönliche Budget und reichen
          diesen bei ihrer zuständigen Behörde ein. Wir helfen Ihnen dabei, den
          richtigen Kostenträger für Sie zu finden. Hier können Sie mehr
          erfahren: <ExternalLink
            href="https://www.bmas.de/DE/Soziales/Teilhabe-und-Inklusion/Rehabilitation-und-Teilhabe/Persoenliches-Budget/Fragen-und-Antworten-DGS/faq-persoenliches-budget.html"
            name="Fragen und Antworten zum persönlichen Budget"
          />
        </p>

        <h3>Ablauf des Verfahrens:</h3>

        <dl>
          <div>
            <Image alt="" src={enquiryOne} width={400} />
            <dt class="highlight">Beratungsgespräch</dt>
            <dd>bei einem Kostenträger oder einer EUTB.</dd>
          </div>

          <div>
            <Image alt="" src={enquiryTwo} width={400} />
            <dt class="highlight">Antragstellung</dt>
            <dd>
              Der erste Schritt ist, einen Antrag bei Ihrer zuständigen
              Sozialbehörde oder dem Träger der Eingliederungshilfe zu stellen.
            </dd>
          </div>

          <div>
            <Image alt="" src={enquiryThree} width={400} />
            <dt class="highlight">Bedarfsfeststellung</dt>
            <dd>
              In der Regel wird ein Bedarfsgutachten erstellt, um festzustellen,
              welche Unterstützungsleistungen für Sie erforderlich sind.
            </dd>
          </div>

          <div>
            <Image alt="" src={enquiryFour} width={400} />
            <dt class="highlight">Zielvereinbarung</dt>
            <dd>
              Die Zielvereinbarung muss zu Ihnen passen und Sie müssen die Ziele
              auch schaffen können.
            </dd>
          </div>

          <div>
            <Image alt="" src={enquiryFive} width={400} />
            <dt class="highlight">Bewilligung und Bescheid</dt>
            <dd>
              Wenn Ihr Antrag genehmigt wird, erhalten Sie das Persönliche
              Budget, welches Sie dann nutzen können, um Ihre gewünschte
              Dienstleistung zu finanzieren.
            </dd>
          </div>
        </dl>

        <p>
          Wird das Persönliche Budget ausschließlich durch die
          Pflegeversicherung erbracht, ist keine Zielvereinbarung notwendig.
        </p>
      </div>
    </section>

    <section aria-label="Leistungen">
      <div class="container">
        <h2>Welche Leistungen sind enthalten?</h2>

        <ul role="list">
          <li>
            <div class="img-container">
              <Image alt="" src={serviceOne} />
            </div>
            <p class="highlight">Wohnen und Alltagsunter&shy;stützung</p>
          </li>
          <li>
            <div class="img-container">
              <Image alt="" src={serviceTwo} />
            </div>
            <p class="highlight">Grundpflege</p>
          </li>
          <li>
            <div class="img-container">
              <Image alt="" src={serviceThree} />
            </div>
            <p class="highlight">Freizeit und Kultur</p>
          </li>
          <li>
            <div class="img-container">
              <Image alt="" src={serviceFour} />
            </div>
            <p class="highlight">Urlaub</p>
          </li>
          <li>
            <div class="img-container">
              <Image alt="" src={serviceFive} />
            </div>
            <p class="highlight">Arbeit, Ausbildung, Studium &amp; Schule</p>
          </li>
          <li>
            <div class="img-container">
              <Image alt="" src={serviceSix} />
            </div>
            <p class="highlight">Begleitung zu Terminen</p>
          </li>
        </ul>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* General */

  dd {
    hyphens: manual;
    margin: 0;
  }

  /* Section 1 */

  section[aria-label="Allgemein"] {
    background: var(--color-light-cream-50);
  }

  .wrapper {
    padding: var(--space-2xl) 0;
  }

  section[aria-label="Allgemein"] h2 {
    margin-top: var(--space-2xl);
  }

  .flex {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
    justify-content: space-between;
    margin: 0 auto;
    max-width: 1440px;
    padding: 0 var(--space-m);
  }

  .flex p {
    margin: 0;
  }

  .highlight {
    max-width: 30ch;
  }

  .flex p:nth-child(2) {
    max-width: 40ch;
  }

  .gallery {
    display: grid;
    grid-gap: var(--space-m);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15ch), 1fr));
    justify-items: center;
    width: 100%;
  }

  .gallery dt {
    text-align: center;
  }

  .gallery div {
    display: flex;
    flex-direction: column;
    flex-wrap: wrap;
    gap: var(--space-m);
  }

  /* Section 2 */

  section[aria-label="Prozess"] {
    margin: 0 auto;
    max-width: 1440px;
    padding: 0 var(--space-m);
  }

  section[aria-label="Prozess"] h2,
  section[aria-label="Prozess"] h3 {
    margin-top: var(--space-2xl);
  }

  section[aria-label="Prozess"] p {
    text-wrap: balance;
  }

  section[aria-label="Prozess"] dd {
    max-width: 30ch;
  }

  /* Section 3 */

  section[aria-label="Leistungen"] {
    background: var(--color-light-cream-50);
  }

  section[aria-label="Leistungen"] h2 {
    margin: 0;
  }

  .img-container {
    background: var(--color-light-cream-100);
    border-radius: 8px;
    padding: var(--space-m);
  }

  .img-container img {
    margin: 0 auto;
  }

  section[aria-label="Leistungen"] ul {
    display: grid;
    grid-gap: var(--space-l);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20ch), 1fr));
    margin-top: var(--space-2xl);
  }

  section[aria-label="Leistungen"] p {
    margin-top: var(--space-xs);
    text-align: center;
  }
</style>
